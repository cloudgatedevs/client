{
  "name": "@cloudgatedevs/cloudgate-client",
  "version": "0.7.0",
  "description": "Dependency-free Cloudgate API, authentication and WebSocket helpers for any JavaScript framework or Node.js.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/auth.js",
    "src/websockets.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudgate",
    "api",
    "gateway",
    "hmac",
    "sdk",
    "client",
    "workflow",
    "websocket",
    "realtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudgatedevs/client.git"
  },
  "homepage": "https://github.com/cloudgatedevs/client#readme",
  "bugs": {
    "url": "https://github.com/cloudgatedevs/client/issues"
  },
  "author": "Cloudgate Devs (https://cloudgate.dev)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
